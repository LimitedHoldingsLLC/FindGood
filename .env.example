# =============================================================================
# FindGood environment template
# Copy to .env for local development. Never commit real secrets.
# =============================================================================

# --- Runtime ---
APP_ENV=development
APP_NAME=FindGood
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Public URLs ---
# Backend origin used by the API itself (OpenAPI, redirects, worker callbacks).
API_BASE_URL=http://localhost:8000
# Frontend origin. Used for CORS and canonical URL generation.
WEB_BASE_URL=http://localhost:3000
# Public consumer domain (canonical). happyhour.food is an acquisition alias.
CANONICAL_HOST=findgood.food
ACQUISITION_HOST=happyhour.food

# --- Database (Render Postgres in production; Docker Compose locally) ---
DATABASE_URL=postgresql+psycopg://findgood:findgood@localhost:5432/findgood

# --- Queue (Render Key Value in production; Docker Compose Redis locally) ---
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=redis

# --- CORS ---
# Comma-separated origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Admin ---
# Username/password for the /admin UI. ADMIN_API_KEY signs session tokens and
# remains valid as X-Admin-Key for scripts. Production must override all three.
# Never put real passwords here — copy to .env (gitignored) and set them there.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-admin-password
ADMIN_API_KEY=change-me-to-a-long-random-admin-key
ADMIN_SESSION_TTL_SECONDS=43200
# Login lockout: 5 failures / 15 minutes per IP, 25 failures globally, then 15-minute lock.
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_LOCKOUT_SECONDS=900
ADMIN_LOGIN_GLOBAL_MAX_FAILURES=25

# --- Feature flags (true/false) ---
FEATURE_DEAL_SCORE=true
FEATURE_MAPS=true
FEATURE_ACCOUNTS=false
FEATURE_COMMUNITY_VERIFICATION=false
FEATURE_FLASH_DEALS=false
FEATURE_RESTAURANT_PORTAL=false
FEATURE_AI_EXTRACTION=false

# --- Crawler / fetcher safety ---
CRAWLER_USER_AGENT=FindGoodBot/1.0 (+https://findgood.food/bot)
CRAWLER_REQUEST_TIMEOUT_SECONDS=15
CRAWLER_MAX_RESPONSE_BYTES=1048576
CRAWLER_MAX_CONCURRENCY=10
CRAWLER_DOMAIN_CONCURRENCY=1
CRAWLER_DEFAULT_RATE_LIMIT_PER_MINUTE=6
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_MAX_PAGES_PER_DOMAIN=10
CRAWLER_MAX_PAGES_PER_RUN=40
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_REDIRECTS=3
CRAWLER_RETRY_COUNT=3
CRAWLER_PER_DOMAIN_DELAY_SECONDS=1.0
CRAWLER_ALLOWED_CONTENT_TYPES=text/html,application/xhtml+xml,application/json,text/plain

# --- Provider APIs (leave blank to keep the provider disabled/not configured) ---
# Google Places (New) key from Google Cloud. Paid after free quota.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_CALLS_PER_RUN=20
GOOGLE_PLACES_ENABLED=true
# Yelp Fusion API key. Subject to Yelp rate limits and display terms.
YELP_API_KEY=
YELP_MAX_CALLS_PER_RUN=20
YELP_ENABLED=true
# Tripadvisor Content API key (partner approval). Do not scrape Tripadvisor HTML.
TRIPADVISOR_API_KEY=
TRIPADVISOR_MAX_CALLS_PER_RUN=20
TRIPADVISOR_ENABLED=true
# OpenTable has no public listing API here. A key alone will not enable scraping.
OPENTABLE_API_KEY=
OPENTABLE_ENABLED=false

# --- Freshness windows (days) ---
BUSINESS_STALE_AFTER_DAYS=30
HOURS_STALE_AFTER_DAYS=14
HAPPY_HOUR_STALE_AFTER_DAYS=7
SPECIAL_STALE_AFTER_DAYS=3
CONTACT_STALE_AFTER_DAYS=21
AGING_RATIO=0.6
ADMIN_BULK_LIMIT=50
ADMIN_EXPORT_ROW_LIMIT=5000

# --- Observability ---
# If incoming requests omit X-Request-ID, the API generates one.

# --- Frontend (also copy relevant values into apps/web/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CANONICAL_HOST=findgood.food
# Browser Maps key. Restrict it to findgood.food HTTP referrers. Never put the
# server Places/geocoding secret here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_MAP_DEFAULT_LAT=34.0522
NEXT_PUBLIC_MAP_DEFAULT_LNG=-118.2437
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# Server-only geocoding. Used in background enrichment, never while drawing pins.
GEOCODING_ENABLED=true
GEOCODING_API_KEY=
MAX_GEOCODES_PER_RUN=20
MAX_GEOCODES_PER_DAY=100
MAP_MAX_RESULTS=80
MAP_CACHE_TTL_SECONDS=30
