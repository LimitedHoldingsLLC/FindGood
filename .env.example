# =============================================================================
# FindGood environment template
# Copy to .env for local development. Never commit real secrets.
# =============================================================================

# --- Runtime ---
APP_ENV=development
APP_NAME=FindGood
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Public URLs ---
# Backend origin used by the API itself (OpenAPI, redirects, worker callbacks).
API_BASE_URL=http://localhost:8000
# Frontend origin. Used for CORS and canonical URL generation.
WEB_BASE_URL=http://localhost:3000
# Public consumer domain (canonical). happyhour.food is an acquisition alias.
CANONICAL_HOST=findgood.food
ACQUISITION_HOST=happyhour.food

# --- Database (Render Postgres in production; Docker Compose locally) ---
DATABASE_URL=postgresql+psycopg://findgood:findgood@localhost:5432/findgood

# --- Queue (Render Key Value in production; Docker Compose Redis locally) ---
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=redis

# --- CORS ---
# Comma-separated origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Admin ---
# Long random string. Required to access /api/v1/admin/*.
ADMIN_API_KEY=change-me-to-a-long-random-admin-key

# --- Feature flags (true/false) ---
FEATURE_DEAL_SCORE=true
FEATURE_MAPS=false
FEATURE_ACCOUNTS=false
FEATURE_COMMUNITY_VERIFICATION=false
FEATURE_FLASH_DEALS=false
FEATURE_RESTAURANT_PORTAL=false
FEATURE_AI_EXTRACTION=false

# --- Crawler / fetcher safety ---
CRAWLER_USER_AGENT=FindGoodBot/0.1 (+https://findgood.food/bot)
CRAWLER_REQUEST_TIMEOUT_SECONDS=10
CRAWLER_MAX_RESPONSE_BYTES=1048576
CRAWLER_MAX_CONCURRENCY=2
CRAWLER_DEFAULT_RATE_LIMIT_PER_MINUTE=6
CRAWLER_RESPECT_ROBOTS_TXT=true

# --- Observability ---
# If incoming requests omit X-Request-ID, the API generates one.

# --- Frontend (also copy relevant values into apps/web/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CANONICAL_HOST=findgood.food
